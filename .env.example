# Password untuk login ke aplikasi (kamu yang tentukan sendiri)
APP_PASSWORD=ganti-dengan-password-kamu

# Kunci rahasia untuk menandatangani cookie sesi.
# WAJIB minimal 32 karakter acak (bertambah dari sebelumnya 16).
# Contoh generate: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Origin aplikasi yang dibuka browser, TANPA path di belakangnya.
# Development: http://localhost:3000
# Production: ganti dengan origin HTTPS aplikasimu.
APP_ORIGIN=http://localhost:3000

# API key dari LLMsRelay (format sk-cs4-*)
# Bisa isi 1 key, atau beberapa dipisah koma (tanpa spasi) buat rotasi
# kalau salah satu kena rate limit:
# LLMSRELAY_API_KEYS=sk-cs4-key1,sk-cs4-key2,sk-cs4-key3
LLMSRELAY_API_KEYS=sk-cs4-xxxxxxxxxxxxxxxx

# ID model Claude yang benar-benar tersedia di akun/provider LLMsRelay-mu.
CLAUDE_MODEL=ganti-dengan-id-model-claude-yang-valid

# Base URL LLMsRelay (biasanya tidak perlu diubah)
LLMSRELAY_BASE_URL=https://api.llmsrelay.com

# API key Gemini dari Google AI Studio (aistudio.google.com) — dipanggil
# langsung ke Google, TIDAK lewat LLMsRelay.
# Sama seperti di atas, bisa isi beberapa key dipisah koma untuk rotasi:
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
GEMINI_API_KEYS=xxxxxxxxxxxxxxxx

# ID model Gemini yang benar-benar tersedia di akun Google AI Studio-mu.
GEMINI_MODEL=ganti-dengan-id-model-gemini-yang-valid
